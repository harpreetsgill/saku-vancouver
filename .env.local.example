# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# Notion integration token ("Internal Integration Secret", starts with `secret_` / `ntn_`)
# Create at https://www.notion.so/my-integrations, then share each database below with it.
NOTION_KEY=

# Notion database IDs (the 32-char id in the database URL)
MISC_DB_ID=
GALLERY_DB_ID=
LOCATIONS_DB_ID=
REGULAR_MENU_DB_ID=
TAKEOUT_MENU_DB_ID=
